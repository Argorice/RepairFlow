# Скопируйте в .env и подставьте свои значения. Файл .env в git не попадает.

# Секрет подписи JWT: минимум 32 символа.
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# Подключение к базе. Локально — Postgres из docker compose,
# в продакшне — строка из Neon (Dashboard → Connection Details → .NET).
# Neon отдаёт pooled-эндпоинт (с «-pooler») — он подходит: Npgsql по умолчанию
# не готовит prepared statements, а блокировка выдачи номера заявки живёт внутри транзакции.
ConnectionStrings__Default=Host=localhost;Port=5433;Database=repairflow;Username=repairflow;Password=repairflow

# Адрес фронтенда для CORS. В продакшне — домен на Vercel.
Cors__Origins__0=http://localhost:5173
